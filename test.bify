class Base{
    public void bark(){
        printf("Bark!\n");
    }
}
class Dummy:Base{
    public int x;
    constructor(){
        this.x = 1212;
    }
    public int getX() {
        return this.x;
    }
}
void main(){
    Dummy a;
    a = new Dummy();
    printf("x: %d", a.getX());
