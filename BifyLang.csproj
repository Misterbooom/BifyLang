<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyTitle>BifyLang</AssemblyTitle>
    <Product>BifyLang</Product>
    <Copyright>Copyright © 2024</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <RootNamespace>BifyLang</RootNamespace>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);DEBUG_COMPILE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="libLLVM" Version="23.1.0" />
    <PackageReference Include="libLLVM.runtime.linux-x64" Version="23.1.0" />
    <PackageReference Include="LLVMSharp" Version="20.1.2" />
    <PackageReference Include="LLVMSharp.Interop" Version="20.1.2" />
    <PackageReference Include="Spectre.Console" Version="0.57.3-alpha.0.13" />
    <PackageReference Include="System.CommandLine" Version="3.0.0-preview.7.26381.103" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="BifyLang.Tests\**" />
    <None Remove="BifyLang.Tests\**" />
    <EmbeddedResource Remove="BifyLang.Tests\**" />
  </ItemGroup>

  <PropertyGroup>
    <RuntimeSource>$(MSBuildProjectDirectory)/CodeGen/Core/Runtime/runtime.c</RuntimeSource>
    <RuntimeObj>$(MSBuildProjectDirectory)/obj/runtime.o</RuntimeObj>
  </PropertyGroup>

  <Target Name="CompileRuntime" BeforeTargets="BeforeBuild;AssignTargetPaths" Inputs="$(RuntimeSource)" Outputs="$(RuntimeObj)">
    <MakeDir Directories="$(MSBuildProjectDirectory)/obj" />
    <Exec Command="clang -c -O2 -fPIC &quot;$(RuntimeSource)&quot; -o &quot;$(RuntimeObj)&quot;" />
  </Target>

  <ItemGroup>
    <None Include="$(RuntimeObj)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>runtime.o</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>
</Project>
