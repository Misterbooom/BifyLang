; ModuleID = 'main'
source_filename = "main"

%Dummy = type { ptr, i32, i32, i32 }

@.str = private constant [7 x i8] c"Bark!\0A\00"
@Base.vtable = internal constant [1 x ptr] [ptr @Base.bark]
@Dummy.vtable = internal constant [2 x ptr] [ptr @Base.bark, ptr @Dummy.getX]
@.str.1 = private constant [6 x i8] c"x: %d\00"

declare void @gc_retainStrong(ptr)

declare void @gc_retainWeak(ptr)

declare void @gc_releaseStrong(ptr)

declare void @gc_releaseWeak(ptr)

declare ptr @gc_upgradeWeak(ptr)

declare i32 @printf(ptr, ...)

define void @Base.bark(ptr %0) {
entry:
  %this = alloca ptr, align 8
  store ptr %0, ptr %this, align 8
  %1 = call i32 (ptr, ...) @printf(ptr @.str)
  ret void
}

define void @Dummy.constructor(ptr %0) {
entry:
  %this = alloca ptr, align 8
  store ptr %0, ptr %this, align 8
  %this1 = load ptr, ptr %this, align 8
  %x = getelementptr inbounds nuw %Dummy, ptr %this1, i32 0, i32 3
  store i32 1212, ptr %x, align 4
  ret void
}

define i32 @Dummy.getX(ptr %0) {
entry:
  %this = alloca ptr, align 8
  store ptr %0, ptr %this, align 8
  %this1 = load ptr, ptr %this, align 8
  %x = getelementptr inbounds nuw %Dummy, ptr %this1, i32 0, i32 3
  %x2 = load i32, ptr %x, align 4
  ret i32 %x2
}

define void @main() {
entry:
  %a = alloca ptr, align 8
  store ptr null, ptr %a, align 8
  %Dummy_inst = tail call ptr @malloc(i32 ptrtoint (ptr getelementptr (%Dummy, ptr null, i32 1) to i32))
  %vptr_slot = getelementptr inbounds nuw %Dummy, ptr %Dummy_inst, i32 0, i32 0
  store ptr @Dummy.vtable, ptr %vptr_slot, align 8
  %strong_count = getelementptr inbounds nuw %Dummy, ptr %Dummy_inst, i32 0, i32 1
  %weak_count = getelementptr inbounds nuw %Dummy, ptr %Dummy_inst, i32 0, i32 2
  store i32 1, ptr %strong_count, align 4
  store i32 1, ptr %weak_count, align 4
  %x = getelementptr inbounds nuw %Dummy, ptr %Dummy_inst, i32 0, i32 3
  store i32 0, ptr %x, align 4
  call void @Dummy.constructor(ptr %Dummy_inst)
  %old_a = load ptr, ptr %a, align 8
  call void @gc_releaseStrong(ptr %old_a)
  store ptr %Dummy_inst, ptr %a, align 8
  %a1 = load ptr, ptr %a, align 8
  %vptr_slot2 = getelementptr inbounds nuw %Dummy, ptr %a1, i32 0, i32 0
  %vtable = load ptr, ptr %vptr_slot2, align 8
  %slot_ptr = getelementptr ptr, ptr %vtable, i32 1
  %getX_fn = load ptr, ptr %slot_ptr, align 8
  %0 = call i32 %getX_fn(ptr %a1)
  %1 = call i32 (ptr, ...) @printf(ptr @.str.1, i32 %0)
  %cleanup_a = load ptr, ptr %a, align 8
  call void @gc_releaseStrong(ptr %cleanup_a)
  ret void
}

declare noalias ptr @malloc(i32)
