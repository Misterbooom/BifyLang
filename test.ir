; ModuleID = 'main'
source_filename = "main"

%Dummy = type { ptr, i32, i32 }

@Dummy.vtable = internal constant [1 x ptr] [ptr @Dummy.getX]
@.str = private constant [8 x i8] c"Success\00"
@.str.1 = private constant [17 x i8] c"Failde but still\00"

declare void @gc_retainStrong(ptr)

declare void @gc_retainWeak(ptr)

declare void @gc_releaseStrong(ptr)

declare void @gc_releaseWeak(ptr)

declare ptr @gc_upgradeWeak(ptr)

declare i32 @printf(ptr, ...)

define void @Dummy.constructor(ptr %0) {
entry:
  %this = alloca ptr, align 8
  store ptr %0, ptr %this, align 8
  ret void
}

define i32 @Dummy.getX(ptr %0) {
entry:
  %this = alloca ptr, align 8
  store ptr %0, ptr %this, align 8
  ret i32 1
}

define void @main() {
entry:
  %Dummy_inst = tail call ptr @malloc(i32 ptrtoint (ptr getelementptr (%Dummy, ptr null, i32 1) to i32))
  %vptr_slot = getelementptr inbounds nuw %Dummy, ptr %Dummy_inst, i32 0, i32 0
  store ptr @Dummy.vtable, ptr %vptr_slot, align 8
  %strong_count = getelementptr inbounds nuw %Dummy, ptr %Dummy_inst, i32 0, i32 1
  %weak_count = getelementptr inbounds nuw %Dummy, ptr %Dummy_inst, i32 0, i32 2
  store i32 1, ptr %strong_count, align 4
  store i32 1, ptr %weak_count, align 4
  call void @Dummy.constructor(ptr %Dummy_inst)
  %d = alloca ptr, align 8
  store ptr %Dummy_inst, ptr %d, align 8
  %d1 = load ptr, ptr %d, align 8
  %ptrneq = icmp ne ptr %d1, null
  br i1 %ptrneq, label %and_rhs, label %and_merge

else.body:                                        ; preds = %and_merge
  %0 = call i32 (ptr, ...) @printf(ptr @.str.1)
  br label %if.merge

and_rhs:                                          ; preds = %entry
  %d2 = load ptr, ptr %d, align 8
  %vptr_slot3 = getelementptr inbounds nuw %Dummy, ptr %d2, i32 0, i32 0
  %vtable = load ptr, ptr %vptr_slot3, align 8
  %slot_ptr = getelementptr ptr, ptr %vtable, i32 0
  %getX_fn = load ptr, ptr %slot_ptr, align 8
  %1 = call i32 %getX_fn(ptr %d2)
  %eqtmp = icmp eq i32 %1, 1
  br label %and_merge

and_merge:                                        ; preds = %and_rhs, %entry
  %logical_tmp = phi i1 [ false, %entry ], [ %eqtmp, %and_rhs ]
  br i1 %logical_tmp, label %if.then, label %else.body

if.then:                                          ; preds = %and_merge
  %2 = call i32 (ptr, ...) @printf(ptr @.str)
  br label %if.merge

if.merge:                                         ; preds = %else.body, %if.then
  %cleanup_d = load ptr, ptr %d, align 8
  call void @gc_releaseStrong(ptr %cleanup_d)
  ret void
}

declare noalias ptr @malloc(i32)
